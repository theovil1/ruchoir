# Local, private, or AI-facing files that must never reach the public repo.
# The only AI-facing file allowed on the repo is AGENTS.md.
/CLAUDE.md
/CAHIER-DES-CHARGES.md
/.claude/
# Internal, lot-numbered planning specs (kept local, like the cahier).
/docs/specs/

# Local development assets: import fixtures, work exports, seed stacks, design handoff.
/fixtures/
/workchat-design-system/

# Secrets and environment.
.env
.env.*
!.env.example

# Dependencies and build output (filled in as the stack lands).
/node_modules/
/target/
/.next/
/dist/
/apps/web/out/
# Generated self-hosted emoji pack (built from the Fluent Emoji repos by scripts/prepare-emoji.mjs).
/apps/web/public/emoji/

# Local dev TLS material (generated by scripts/dev-tls.sh).
/certs/
